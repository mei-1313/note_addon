{
  "manifest_version": 3,
  "name": "note 統計CSVダウンロード",
  "version": "1.1.0",
  "description": "noteの統計ページからデータをCSVとしてダウンロードします。",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://note.com/sitesettings/stats*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://note.com/sitesettings/stats*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
